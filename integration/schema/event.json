{
  "type": "object",
  "required": ["type", "event_id", "timestamp", "event"],
  "properties": {
    "type": {
      "type": "string",
      "enum": ["event"]
    },
    "event_id": {
      "type": "integer",
      "description": "Unique event identifier"
    },
    "timestamp": {
      "type": "number",
      "description": "Unix timestamp"
    },
    "event": {
      "type": "string",
      "enum": [
        "human_detected",
        "object_detected",
        "intruder_alert",
        "battery_low",
        "battery_critical",
        "motor_failure",
        "camera_offline",
        "obstacle_detected",
        "system_error",
        "mission_started",
        "mission_completed"
      ]
    },
    "severity": {
      "type": "string",
      "enum": ["info", "warning", "critical"]
    },
    "source": {
      "type": "string",
      "description": "Component that generated the event"
    },
    "data": {
      "type": "object",
      "description": "Additional event data",
      "properties": {
        "confidence": {
          "type": "number",
          "description": "AI detection confidence"
        },
        "object_type": {
          "type": "string"
        },
        "battery_voltage": {
          "type": "number"
        },
        "distance": {
          "type": "number"
        },
        "camera_id": {
          "type": "string"
        }
      }
    }
  }
}